# ============================================================
#  ENVIRONMENT VARIABLES — TEMPLATE ONLY
#  Copy to `.env.local` for development.
#  NEVER commit a real `.env` file or paste real secrets here.
#  Every value below is a PLACEHOLDER, not a credential.
# ============================================================

# Public canonical site URL. Used for metadata and CSP.
# NEXT_PUBLIC_ variables are exposed to the browser by design —
# only ever put non-sensitive values behind this prefix.
NEXT_PUBLIC_SITE_URL="https://gokulkrishana.vercel.app"

# --- Contact endpoint (server-only, never exposed to the client) ---
# Optional. If absent, the contact endpoint validates + rate-limits
# the submission and the site falls back to a prefilled mail draft.
# CONTACT_TO_EMAIL="you@example.com"

# Optional transactional email provider key. Server-side ONLY.
# If unset, no email is sent and the client uses the mailto fallback.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"